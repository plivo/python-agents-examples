# Deepgram Voice Agent API (listen + think + speak in one managed pipeline)
DEEPGRAM_API_KEY=

# EU endpoint: wss://api.eu.deepgram.com/v1/agent/converse
# DEEPGRAM_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse

# Model configuration -- values are passed verbatim into Deepgram's Settings
# (agent.listen / agent.think / agent.speak). Use Deepgram's own model ids and
# provider types: https://developers.deepgram.com/docs/voice-agent-llm-models
# and https://developers.deepgram.com/docs/voice-agent-tts-models

# Listen: Flux (flux-*) sends version v2 + the EOT params; other models
# (e.g. nova-3) send DEEPGRAM_LISTEN_LANGUAGE instead, if set
DEEPGRAM_LISTEN_MODEL=flux-general-en
DEEPGRAM_LISTEN_EOT_THRESHOLD=0.7
DEEPGRAM_LISTEN_EOT_TIMEOUT_MS=5000
# DEEPGRAM_LISTEN_LANGUAGE=en

# Think: provider type (open_ai, anthropic, google, groq, nvidia) + model id
DEEPGRAM_THINK_PROVIDER=open_ai
DEEPGRAM_THINK_MODEL=gpt-4.1-mini
DEEPGRAM_THINK_TEMPERATURE=0.7

# Speak: Aura-2 voice (aura-2-*) or Flux TTS voice (flux-*, sent with version v2)
DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en

# Agent path per direction: empty = inline (Settings carries the full agent definition
# built from the vars above, system_prompt.md and FUNCTION_DEFINITIONS). Set to a Deepgram
# reusable agent config UUID to reference that config instead; create one with the README
# commands ("Creating a reusable config"). The model vars above are then not used.
# DEEPGRAM_INBOUND_AGENT_ID=
# DEEPGRAM_OUTBOUND_AGENT_ID=

# Greeting spoken verbatim by the speak model when the call connects (inbound)
# AGENT_GREETING=Hi, this is Alex from TechFlow...

# Plivo Credentials
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Webhook authentication (always on): Plivo webhooks must carry a valid V3 signature
# (checked with PLIVO_AUTH_TOKEN against PUBLIC_URL + path + query), and /ws needs the
# 5-minute token that the signed answer webhook adds to the stream URL. The server refuses
# to start without PLIVO_AUTH_TOKEN.

# Plivo Phone Number (for auto-configuration)
# The server will automatically configure this number's webhooks on startup
# Supports any format: +1-234-567-8901, (234) 567-8901, 919880465079, etc.
PLIVO_PHONE_NUMBER=

# Second Plivo number used only for E2E tests (caller for inbound, destination for outbound)
# PLIVO_TEST_NUMBER=

# Default country code for phone numbers without country prefix (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY_CODE=US

# Public URL for webhooks (tunnel URL or production domain). Must be exactly the scheme +
# host Plivo calls: webhook signatures are verified against it.
# Leave empty when running with `--tunnel` (a Cloudflare quick tunnel URL is used).
# Otherwise required for auto-configuration. Example: https://agent.example.com
PUBLIC_URL=

# Server port
SERVER_PORT=8000

# Logging: "verbose", "normal" (default), "quiet"
# LOG_LEVEL=normal
# LOG_FORMAT=text
# LOG_FILE=

# Redis Streams (optional — for real-time event publishing to UIs)
# REDIS_EVENTS_URL=redis://localhost:6379
# REDIS_STREAM_KEY=voice-agent:events

# OpenTelemetry (optional — for distributed tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# The system prompts are inbound/system_prompt.md and outbound/system_prompt.md (no env
# override). Edit them, or mount your own file over them in Docker (see the README).
