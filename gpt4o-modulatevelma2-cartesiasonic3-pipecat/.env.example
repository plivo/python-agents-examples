# OpenAI API (LLM)
OPENAI_API_KEY=

# Modulate API (STT): platform.modulate.ai, API Keys tab
MODULATE_API_KEY=

# Cartesia API (TTS)
CARTESIA_API_KEY=

# Tavily API (web search tool): app.tavily.com
TAVILY_API_KEY=

# Model Configuration
LLM_MODEL=gpt-4o
TTS_MODEL=sonic-3.6
TTS_VOICE=71a7ad14-091c-4e8e-a314-022ece01c121

# Tavily search depth: ultra-fast, fast, basic or advanced
TAVILY_SEARCH_DEPTH=fast

# Plivo Credentials. Both are required; use a subaccount's pair if the number belongs to
# a subaccount.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Plivo Phone Number: the inbound server points it at PUBLIC_URL on startup; for outbound
# it is the "from" of your Make Call request. Any format: +1-234-567-8901, 919880465079.
PLIVO_PHONE_NUMBER=

# Default country code for phone numbers without country prefix (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY_CODE=US

# Public URL of the server (ngrok URL or production domain). Must be exactly the scheme +
# host Plivo calls, e.g. https://abc123.ngrok.io
PUBLIC_URL=

# Server ports: inbound.server and outbound.server (different, so both can run at once)
SERVER_PORT=8000
OUTBOUND_SERVER_PORT=8001

# --- Tests only (not read by the servers) ---
# Second Plivo number for live call tests (caller for inbound, destination for outbound)
# PLIVO_TEST_NUMBER=
# Path to the ngrok binary used by the live call tests (default: "ngrok" on PATH)
# NGROK_BIN=ngrok
# Directory holding an ffmpeg binary to prefer over the imageio-ffmpeg dev dependency's
# FFMPEG_DIR=
# Where test server logs are written (default: the system temp dir)
# TEST_LOG_DIR=
