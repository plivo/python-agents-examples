# OpenAI API (LLM)
OPENAI_API_KEY=

# Modulate API (STT): platform.modulate.ai, API Keys tab
MODULATE_API_KEY=

# Cartesia API (TTS)
CARTESIA_API_KEY=

# Tavily API (web search tool): app.tavily.com
TAVILY_API_KEY=

# Model Configuration
LLM_MODEL=gpt-4o
# Cartesia's current stable Sonic model ID (tracks the latest stable snapshot). Pin a dated
# snapshot, e.g. sonic-3.6-2026-08-27, for behaviour that never changes.
TTS_MODEL=sonic-3.6
TTS_VOICE=71a7ad14-091c-4e8e-a314-022ece01c121

# Tavily search depth: ultra-fast, fast, basic or advanced.
TAVILY_SEARCH_DEPTH=fast

# Plivo Credentials
# PLIVO_AUTH_TOKEN is required: Plivo webhooks and the /ws audio stream must carry a valid
# V3 signature (always on), checked with PLIVO_AUTH_TOKEN against PUBLIC_URL (webhook:
# PUBLIC_URL + path + query; stream: http:// + its host + path). Both servers refuse to
# start without it. Use a subaccount's token if the number belongs to a subaccount.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Plivo Phone Number
# Inbound server only: on startup it points this number's answer/hangup webhooks at
# PUBLIC_URL (auto-configuration). The outbound server does not configure anything; use
# this number as "from" when placing calls with Plivo's Make Call API.
# Supports any format: +1-234-567-8901, (234) 567-8901, 919880465079, etc.
PLIVO_PHONE_NUMBER=

# Default country code for phone numbers without country prefix (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY_CODE=US

# Public URL for webhooks (ngrok URL or production domain). Must be exactly the scheme +
# host Plivo calls: webhook and stream signatures are verified against it, and the <Stream>
# WebSocket URL is built from it. Required for inbound auto-configuration.
# Example: https://abc123.ngrok.io
PUBLIC_URL=

# Server ports: inbound.server and outbound.server (different, so both can run at once)
SERVER_PORT=8000
OUTBOUND_SERVER_PORT=8001

# The system prompts are inbound/system_prompt.md and outbound/system_prompt.md (no env
# override). Edit them, or mount your own file over them in Docker.

# --- Tests only (not read by the servers) ---
# Second Plivo number used only for E2E tests (caller for inbound, destination for outbound)
# PLIVO_TEST_NUMBER=
# Path to the ngrok binary used by the live-call tests (default: "ngrok" on PATH)
# NGROK_BIN=ngrok
# Directory holding an ffmpeg binary to prefer over the one from the imageio-ffmpeg dev dependency
# FFMPEG_DIR=
# Where test server logs are written (default: the system temp dir)
# TEST_LOG_DIR=
